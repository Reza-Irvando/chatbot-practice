# =========================================================
# MCP Server Environment — Knowledge Base & Vector Store UU PDP
# =========================================================

# 1. PostgreSQL / pgvector
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatbot_db
DB_USER=postgres
DB_PASSWORD=postgres
DOC_TABLE_NAME=uupdp_dokumen

# 2. Google Gemini Embedding API
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBED_DIMENSION=768

# 3. Parameter Retrieval & Chunking
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.40
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# 4. MCP Transport
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_TRANSPORT=sse
