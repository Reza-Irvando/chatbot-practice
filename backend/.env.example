# =========================================================
# Backend Environment — Dify Chatflow API
# Salin file ini ke backend/.env dan isi nilainya
# =========================================================

# Endpoint API Chatflow yang sudah di-publish di Dify
DIFY_API_URL=http://172.16.12.98/v1/chat-messages

# API Key dari dashboard Dify (menu API Access > API Keys)
DIFY_API_KEY=your_dify_api_key_here

# Port uvicorn (opsional, default 8000)
PORT=8000

# CORS — origins yang diizinkan mengakses backend (koma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
