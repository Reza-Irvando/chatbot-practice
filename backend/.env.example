# =========================================================
# Backend Environment — Orkestrator Dify & LangGraph (Gemini Flash-Lite)
# =========================================================

# 1. Dify Chatflow API
DIFY_API_URL=http://172.16.12.98/v1/chat-messages
DIFY_API_KEY=

# 2. Google Gemini API (LLM Flash-Lite terbaru)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_TOKENS=1024

# 3. Microservice MCP Server (SSE Endpoint)
# Di container Docker/Podman: http://mcp_server:8000/sse
# Di lokal (saat mcp_server dijalankan di port 8001): http://localhost:8001/sse
MCP_SERVER_URL=http://mcp_server:8000/sse

# 4. Server Backend & CORS
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
